<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/banner_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_warning_banner_high"
    android:padding="13dp"
    android:layout_marginHorizontal="6dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="4dp">

    <!-- Content Row: Authentic Tanggolin Icon + Text Stack -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <!-- Authentic Tanggolin Brand Icon -->
        <ImageView
            android:id="@+id/banner_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="1dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tanggolin"
            android:contentDescription="Tanggolin protection mark" />

        <!-- Text Stack: Headline & Action Tip -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Optional legacy badge id kept hidden for backward compatibility -->
            <TextView
                android:id="@+id/banner_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/banner_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Password detected."
                android:textStyle="bold"
                android:textColor="#991B1B"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01" />

            <TextView
                android:id="@+id/banner_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mask it before sharing."
                android:textColor="#7F1D1D"
                android:textSize="13sp"
                android:lineSpacingExtra="1dp"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </LinearLayout>

    <!-- Clean Action Row: [Dismiss] and [Mask text] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:layout_marginTop="10dp">

        <!-- Dismiss Button -->
        <Button
            android:id="@+id/btn_dismiss"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minHeight="42dp"
            android:minWidth="0dp"
            android:text="Dismiss"
            android:textColor="#991B1B"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_button_ghost"
            android:stateListAnimator="@null"
            android:paddingHorizontal="14dp"
            android:layout_marginEnd="8dp" />

        <!-- Mask Text Button (Solid Pill) -->
        <Button
            android:id="@+id/btn_itago"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minHeight="42dp"
            android:minWidth="96dp"
            android:text="Mask text"
            android:textColor="#FFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_button_itago_high"
            android:stateListAnimator="@null"
            android:paddingHorizontal="18dp" />
    </LinearLayout>
</LinearLayout>
